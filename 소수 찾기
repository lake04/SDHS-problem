using System;
using System.Collections.Generic;

namespace MyCompiler
{
    class Program
    {
        public static void Main(string[] args)
        {
            int N = int.Parse(Console.ReadLine());

            if (N < 2 || N > 10000)
            {
                Console.WriteLine("2 이상 10,000 이하의 정수를 입력하세요.");
                return;
            }

            List<int> primeNums = new List<int>();

            for (int i = 2; i <= N; i++)
            {
                if (IsPrime(i))
                {
                    primeNums.Add(i);
                }
            }

            Console.WriteLine("입력 : " + N);
            Console.WriteLine("소수 목록 : ");

            for (int i = 0; i < primeNums.Count; i++)
            {
                Console.Write(primeNums[i] + " ");
            }
            Console.WriteLine("");
            Console.WriteLine("소수의 개수 : " + primeNums.Count);
        }

        static bool IsPrime(int num)
        {
            if (num != 2 && num % 2 == 0)
            {
                return false;
            }

            double sqrt = Math.Sqrt(num);

            for (int j = 3; j <= sqrt; j++)
            {
                if (num % j == 0)
                {
                    return false;
                }
            }

            return true;
        }
    }
}
